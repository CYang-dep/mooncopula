///|
test "SciPy independent ranks concordance and uniformity" {
  let raw = [
    { x: 8.0, y: 3.0, },
    { x: 2.0, y: 4.0, },
    { x: 2.0, y: 4.0, },
    { x: 5.0, y: 2.0, },
    { x: 9.0, y: 8.0, },
    { x: 1.0, y: 7.0, },
  ]
  close(concordance(raw).tau_b, -0.14285714285714288, 1.0e-13)
  close(spearman(raw), -0.05882352941176471, 1.0e-13)
  close(ranks(raw.map(fn(p) { p.x }))[0], 0.7142857142857143, 1.0e-13)
  close(ranks(raw.map(fn(p) { p.x }))[1], 0.35714285714285715, 1.0e-13)
  close(ranks(raw.map(fn(p) { p.x }))[2], 0.35714285714285715, 1.0e-13)
  close(ranks(raw.map(fn(p) { p.x }))[3], 0.5714285714285714, 1.0e-13)
  close(ranks(raw.map(fn(p) { p.x }))[4], 0.8571428571428571, 1.0e-13)
  close(ranks(raw.map(fn(p) { p.x }))[5], 0.14285714285714285, 1.0e-13)
  let d = uniform_diagnostic([0.03, 0.12, 0.4, 0.42, 0.8, 0.93])
  close(d.ks_distance, 0.24666666666666665, 1.0e-13)
  close(d.cramer_von_mises, 0.0632666666666667, 1.0e-13)
}

